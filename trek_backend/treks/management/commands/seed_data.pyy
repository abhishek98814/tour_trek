from django.core.management.base import BaseCommand
from django.contrib.auth import get_user_model
from treks.models import Trek, Category as TrekCategory, TrekItinerary, TrekAvailability
from tour.models import Tour, TourCategory, TourItinerary, TourAvailability
from datetime import date, timedelta
import random

User = get_user_model()


class Command(BaseCommand):
    help = 'Seed database with sample treks, tours and categories'

    def handle(self, *args, **kwargs):
        self.stdout.write('🌱 Seeding data...')

        # Create admin user if not exists
        admin, created = User.objects.get_or_create(
            username='admin',
            defaults={
                'email': 'admin@treknepal.com',
                'role': 'admin',
                'is_staff': True,
                'is_superuser': True,
                'phone': '+9779800000000',
            }
        )
        if created:
            admin.set_password('admin123')
            admin.save()
            self.stdout.write('✅ Admin user created — username: admin, password: admin123')

        # Create guide user
        guide, created = User.objects.get_or_create(
            username='guide_ram',
            defaults={
                'email': 'ram@treknepal.com',
                'role': 'guide',
                'phone': '+9779800000001',
            }
        )
        if created:
            guide.set_password('guide123')
            guide.save()
            self.stdout.write('✅ Guide user created — username: guide_ram, password: guide123')

        # =====================
        # TREK CATEGORIES
        # =====================
        trek_categories = [
            {'name': 'High Altitude', 'slug': 'high-altitude', 'icon': '🏔️'},
            {'name': 'Cultural', 'slug': 'cultural-trek', 'icon': '🛕'},
            {'name': 'Wildlife', 'slug': 'wildlife-trek', 'icon': '🐆'},
            {'name': 'Valley Trek', 'slug': 'valley-trek', 'icon': '🌿'},
        ]
        for cat_data in trek_categories:
            cat, created = TrekCategory.objects.get_or_create(
                slug=cat_data['slug'],
                defaults={
                    'name': cat_data['name'],
                    'icon': cat_data['icon'],
                    'description': f"{cat_data['name']} treks in Nepal",
                }
            )
            if created:
                self.stdout.write(f'  ✅ Trek category: {cat.name}')

        high_alt = TrekCategory.objects.get(slug='high-altitude')
        valley = TrekCategory.objects.get(slug='valley-trek')
        cultural = TrekCategory.objects.get(slug='cultural-trek')

